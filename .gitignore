__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# MLflow local tracking store and DVC cache
mlruns/
mlartifacts/
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Datasets are DVC-tracked, not git-tracked
data/*
!data/.gitkeep

# Registry artifacts ARE committed, deliberately: a clean clone must be able to run
# `docker compose up` and answer the README's curl examples without first rebuilding
# the registry from the sibling projects.
#
# Current cost: ~36 MB across 11 serialised emulators, largest single file 7 MB. That is
# well inside GitHub's limits and worth paying for a quickstart that works against real
# models. It is also roughly the ceiling: if more projects are registered, move the
# binaries to DVC and keep only the manifests in git.
